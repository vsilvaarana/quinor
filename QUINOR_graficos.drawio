"&gt;HU-09 solo si RN-03&lt;/font&gt;' style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F3D5E;strokeWidth=2;align=center;verticalAlign=top;spacing=10;fontSize=13;fontFamily=Helvetica;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="728" y="245" width="170" height="75" as="geometry"/></mxCell><mxCell id="c18" value='&lt;b&gt;Severidad RN-04&lt;/b&gt;&lt;br&gt;&lt;font color="#6B7280"&gt;Alta / Media / Baja&lt;/font&gt;' style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F3D5E;strokeWidth=2;align=center;verticalAlign=top;spacing=10;fontSize=13;fontFamily=Helvetica;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="964" y="245" width="170" height="75" as="geometry"/></mxCell><mxCell id="c19" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#0F3D5E;strokeWidth=2;" edge="1" parent="1" source="c14" target="c15"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c20" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#0F3D5E;strokeWidth=2;" edge="1" parent="1" source="c15" target="c16"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c21" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#0F3D5E;strokeWidth=2;" edge="1" parent="1" source="c16" target="c17"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c22" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#0F3D5E;strokeWidth=2;" edge="1" parent="1" source="c17" target="c18"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c23" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#0F3D5E;strokeWidth=2;dashed=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c8" target="c14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b&gt;3. Alerta y gestión (