464" width="360" height="60" as="geometry"/></mxCell><mxCell id="c23" value='&lt;b&gt;HU-07&lt;/b&gt; Conteo de sacos&lt;br&gt;&lt;font color="#6B7280" style="font-size:11px"&gt;S3 - 8 pts&lt;/font&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#21A366;strokeWidth=2;align=left;spacingLeft=8;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="c15"><mxGeometry x="10" y="534" width="360" height="60" as="geometry"/></mxCell><mxCell id="c24" value='&lt;b&gt;HU-08&lt;/b&gt; Personas en zona&lt;br&gt;&lt;font color="#6B7280" style="font-size:11px"&gt;S4 - 5 pts&lt;/font&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#21A366;strokeWidth=2;align=left;spacingLeft=8;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="c15"><mxGeometry x="10" y="604" width="360" height="60" as="geometry"/></mxCell><mxCell id="c25" value='&lt;b&gt;HU-09&lt;/b&gt; Descripción y severidad&lt;br&gt;&lt;font color="#6B7280" style="font-size:11px"&gt;S4 - 5 pts&lt;/font&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#21A366;strokeWidth=2;align=left;spacingLeft=8;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="c15"><mxGeometry x="10" y="674" width="360" height="60" as="geometry"/></mxCell><mxCell id="c26" value='&lt;b&gt;HU-10&lt;/b&gt; Alerta por correo&lt;br&gt;&lt;font color="#6B7280" style="font-size:11px"&gt;S4 - 3 pts&lt;/font&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#21A366;strokeWidth=2;align=left;spacingLeft=8;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="c15"><mxGeometry x="10" y="744" width="360" height="60" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p8" name="F16 Roadmap del producto"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1320" pageHeight="560" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Roadmap del producto" style="text;html=1;align=left;verticalAlign=middle;fontSize=24;fontStyle=1;fontColor=#0F3D5E;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1280" height="40" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;Versión 1.0 - MVP&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#21A366;strokeColor=#21A366;fontColor=#FFFFFF;fontSize=14;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="60" width="310" height="40" as="geometry"/></mxCell><mxCell id="c4" value='&lt;font color="#6B7280"&gt;Sprints 1 a 4 | 07/09 al 30/10/2026&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Meta:&lt;/b&gt; Detectar en la rampa y cerrar el ciclo detectar, alertar, verificar y decidir&lt;br&gt;&lt;br&gt;&lt;b&gt;Funcionalidades:&lt;/b&gt; 14 HU: captura, detección, video, IA (YOLO + VLM), alerta, dashboard de revisión y seguridad&lt;br&gt;&lt;br&gt;&lt;b&gt;Métricas:&lt;/b&gt;&lt;br&gt;Conteo &amp;ge; 95 %&lt;br&gt;Pesada a alerta &amp;lt; 2 min' style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#21A366;strokeWidth=2;align=left;verticalAlign=top;spacing=10;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="100" width="310" height="340" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Versión 1.1 - Piloto&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#2E86DE;strokeColor=#2E86DE;fontColor=#FFFFFF;fontSize=14;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="342" y="60" width="310" height="40" as="geometry"/></mxCell><mxCell id="c6" value='&lt;font color="#6B7280"&gt;4 semanas | noviembre 2026&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Meta:&lt;/b&gt; Validar en una rampa con dos cámaras en paralelo al proceso actual&lt;br&gt;&lt;br&gt;&lt;b&gt;Funcionalidades:&lt;/b&gt; Calibración de tolerancias y umbrales, captura del dataset real, capacitación de supervisores&lt;br&gt;&lt;br&gt;&lt;b&gt;Métricas:&lt;/b&gt;&lt;br&gt;Falsos positivos &amp;lt; 20 %&lt;br&gt;Concordancia &amp;ge; 85 %' style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2E86DE;strokeWidth=2;align=left;verticalAlign=top;spacing=10;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="342" y="100" width="310" height="340" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Versión 2.0 - Operación&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F39C12;strokeColor=#F39C12;fontColor=#FFFFFF;fontSize=14;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="664" y="60" width="310" height="40" as="geometry"/></mxCell><mxCell id="c8" value='&lt;font color="#6B7280"&gt;Sprints 5 y 6 | dic. 2026 a ene. 2027&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Meta:&lt;/b&gt; Robustecer la operación y la gestión&lt;br&gt;&lt;br&gt;&lt;b&gt;Funcionalidades:&lt;/b&gt; HU-15 a HU-20: reportes, auditoría consultable, cola Celery, panel de salud, reentrenamiento, CSV&lt;br&gt;&lt;br&gt;&lt;b&gt;Métricas:&lt;/b&gt;&lt;br&gt;Disponibilidad &amp;ge; 99 %&lt;br&gt;Modelo con datos propios' style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#F39C12;strokeWidth=2;align=left;verticalAlign=top;spacing=10;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="664" y="100" width="310" height="340" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;Versión 3.0 - Custodia en la cadena&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#6B21A8;strokeColor=#6B21A8;fontColor=#FFFFFF;fontSize=14;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="986" y="60" width="310" height="40" as="geometry"/></mxCell><mxCell id="c10" value='&lt;font color="#6B7280"&gt;Ciclo 2027-I&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Meta:&lt;/b&gt; Extender la trazabilidad más allá de la planta&lt;br&gt;&lt;br&gt;&lt;b&gt;Funcionalidades:&lt;/b&gt; IoT en transporte (GPS, precintos), registro en blockchain y participación de transportistas, operador logístico y aduana&lt;br&gt;&lt;br&gt;&lt;b&gt;Métricas:&lt;/b&gt;&lt;br&gt;Reclamos -80 % en 6 meses' style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6B21A8;strokeWidth=2;align=left;verticalAlign=top;spacing=10;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="986" y="100" width="310" height="340" as="geometry"/></mxCell><mxCell id="c11" value="" style="shape=singleArrow;arrowWidth=0.5;arrowSize=0.03;html=1;fillColor=#0F3D5E;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="20" y="460" width="1280" height="26" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>