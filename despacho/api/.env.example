# =============================================================================
# Copiar a .env y cambiar TODAS las claves antes de levantar el stack.
# .env nunca se versiona (ver .gitignore). Seccion 8 del documento funcional.
# =============================================================================

# --- Entorno -----------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO
TZ=America/Lima

# --- Base de datos: MariaDB 10.11, el mismo motor que el hosting -------------
# Las variables siguen llamandose MYSQL_* porque son las que lee el resto del
# compose; el contenedor las traduce a MARIADB_*.
MYSQL_ROOT_PASSWORD=cambiar_clave_root
MYSQL_DATABASE=quinor
MYSQL_USER=quinor
MYSQL_PASSWORD=cambiar_clave_quinor
MYSQL_PORT=3306
DATABASE_URL=mysql+pymysql://quinor:cambiar_clave_quinor@mysql:3306/quinor?charset=utf8mb4

# --- HU-01 bascula -----------------------------------------------------------
BASCULA_ID=BASCULA-01
SCALE_HOST=scale-sim
SCALE_PORT=5020
SCALE_UNIT_ID=1
SCALE_TIMEOUT_SECONDS=5

# --- HU-02 ERP/WMS -----------------------------------------------------------
ERP_BASE_URL=http://erp-mock:8001
ERP_TIMEOUT_SECONDS=5
# Vigencia de la copia local de una orden. Una rampa cargando no deberia depender
# de una llamada de red por cada pesada. 0 desactiva la cache y consulta siempre.
ERP_CACHE_TTL_SECONDS=900
ERP_PORT=8001

# --- HU-15 autenticacion por token opaco -------------------------------------
# No hay clave estatica de API. Cada persona entra con POST /auth/login y recibe
# un token opaco; la cabecera X-API-Key lleva ese token. En base solo vive su
# SHA-256, y revocarlo desde el dashboard corta el acceso en la peticion siguiente.
#
# Vigencia del token emitido, en horas.
TOKEN_TTL_HOURS=12
# Administrador inicial. Se crea solo si el correo no existe todavia: nunca pisa
# la clave de un administrador ya creado, para que una variable de entorno
# filtrada no se convierta en una llave permanente.
# Si ADMIN_PASSWORD queda vacia no se crea ningun usuario y la API arranca sin
# forma de entrar, que es lo correcto en un entorno ya instalado.
ADMIN_EMAIL=admin@quinor.local
ADMIN_PASSWORD=cambiar_clave_admin

# --- HU-05 grabacion de video ------------------------------------------------
# Catalogo de camaras, una por entrada, con el formato id=url. El id es el que
# aparece en salud_componente y en GET /salud. El RNF-04 dimensiona 4 camaras.
# En planta se sustituyen por las URL reales, por ejemplo:
#   CAMERAS=camara-01=rtsp://admin:clave@10.0.0.11:554/Streaming/Channels/101
CAMERAS=camara-01=rtsp://rtsp-server:8554/rampa-01,camara-02=rtsp://rtsp-server:8554/rampa-02
VIDEO_DIR=/video
# Duracion de cada segmento, en segundos. El criterio 1 de HU-05 pide 1 minuto.
SEGMENT_SECONDS=60
# Horas de video que se conservan. El criterio 2 exige 72 como minimo y el
# grabador se niega a arrancar con menos.
RETENTION_HOURS=72
# Por debajo de este porcentaje de disco libre se borra lo mas antiguo aunque no
# llegue a las 72 h, y el componente disco-video queda en error en GET /salud.
MIN_FREE_PCT=10
RTSP_PORT=8554

# --- HU-06 recorte de clips y almacen ----------------------------------------
# Ventana del clip, en segundos. El criterio 1 pide 5 min antes del inicio de
# carga y 2 min despues del cierre.
CLIP_PRE_SECONDS=300
CLIP_POST_SECONDS=120
# De que camara se recorta: la que enfoca la linea de carga.
CLIP_CAMERA=camara-01
# Por debajo de esta cobertura de la ventana el evento pasa a Sin clip en lugar
# de guardar un trozo que haria creer que se tiene la carga entera.
CLIP_MIN_COVERAGE_PCT=50
# Cada cuanto se buscan eventos sin clip. HU-17 sustituira el sondeo por la cola.
CLIP_POLL_SECONDS=5

# MinIO. Sin estas credenciales el grabador no recorta clips y lo avisa al
# arrancar, en lugar de marcar los eventos Sin clip por un fallo de configuracion.
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=quinor
MINIO_SECRET_KEY=cambiar_clave_minio
MINIO_BUCKET=clips
MINIO_SECURE=false
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- HU-07 conteo de sacos ---------------------------------------------------
# A quien le pide el grabador el conteo. Vacio deja HU-07 apagada: el grabador
# sigue grabando y recortando, y los eventos quedan sin conteo.
YOLO_URL=http://yolo:8002
# Clave compartida entre el grabador y el servicio YOLO. Vacio deja el servicio
# abierto dentro de la red interna; en planta se pone.
YOLO_API_KEY=cambiar_clave_yolo
# cpu en desarrollo. En planta, la GPU del RNF-06: 0 o cuda:0.
YOLO_DEVICE=cpu
# Linea de carga en coordenadas relativas x1,y1,x2,y2. Se calibra en el piloto
# mirando un clip real (apartado 9.1). La de por defecto es vertical por el
# centro del cuadro, que es lo que ve una camara de costado.
LINEA_CARGA=0.5,0.0,0.5,1.0
# Fotogramas que se saltan entre inferencia e inferencia. 1 mira todos.
# Subirlo hace perder sacos al rastreador cuando avanzan mas que su propio ancho
# entre un fotograma mirado y el siguiente: cambiarlo obliga a repetir
# `python -m sim.validar` y comprobar el criterio 2.
YOLO_FRAME_STRIDE=1
# --- HU-08 seguimiento de personas -------------------------------------------
# Zona de carga en coordenadas relativas x1,y1,x2,y2, de la esquina superior
# izquierda a la inferior derecha. Dentro de ella se mide la permanencia. Con el
# cuadro entero, quien pasa por el fondo cuenta como presente en la rampa: se
# calibra en el piloto mirando un clip real, igual que la linea.
ZONA_CARGA=0.0,0.0,1.0,1.0
# Personas simultaneas que caben en la rampa sin que sea raro. Por encima, la
# presencia se marca anomala. No es una identidad: es un conteo.
PERSONAS_HABITUALES=3
# Permanencia por encima de la cual una persona llama la atencion, en segundos.
PERMANENCIA_MAX_SEGUNDOS=600
# Por debajo de esto, una deteccion suelta no cuenta como una persona.
PERMANENCIA_MIN_SEGUNDOS=1

# Intentos de conteo por evento antes de dejarlo. Cada fallo queda en auditoria.
COUNT_MAX_ATTEMPTS=3
COUNT_POLL_SECONDS=15
YOLO_TIMEOUT_SECONDS=600

# --- HU-09 descripcion y severidad -------------------------------------------
# A quien le pide el grabador la interpretacion. Vacio la deja apagada: el
# sistema sigue detectando y guardando evidencia, que es lo que el apartado 12
# exige ante una caida de conectividad.
VLM_URL=http://vlm:8003
# Clave compartida entre el grabador y el servicio de vision-lenguaje.
VLM_SERVICE_API_KEY=cambiar_clave_vlm

# Proveedor del modelo. 'stub' por defecto y a proposito: un valor que saliera a
# internet convertiria un despliegue mal configurado en una factura. En planta
# se pone 'anthropic' u 'openai' y se rellena VLM_API_KEY.
VLM_PROVIDER=stub
VLM_API_KEY=
VLM_MODEL=claude-sonnet-4-5
# Apunta al stub mientras no haya proveedor real. Con uno real, se deja vacio.
VLM_BASE_URL=http://vlm-stub:8004
# Los tres intentos del criterio 3 de HU-09.
VLM_MAX_ATTEMPTS=3
VLM_TIMEOUT_SECONDS=420

# Contexto de planta del apartado 9.2. El prompt necesita saber como es una
# carga normal para poder decir que algo no lo fue; se ajusta en el piloto.
PLANTA_PRODUCTO=quinua en sacos de 50 kg
PLANTA_SACOS_POR_CAMION=400
PLANTA_DURACION_CARGA_MIN=45

# --- HU-10 aviso al supervisor -----------------------------------------------
# A quien le pide el grabador el aviso en cuanto el evento queda clasificado.
# Vacio lo deja apagado: el evento se detecta, se graba y se clasifica, y el
# supervisor lo ve en el dashboard; lo que no sale es el correo.
NOTIFY_URL=http://notificaciones:8004
# Clave compartida entre el grabador y el servicio de notificaciones.
NOTIFY_SERVICE_API_KEY=cambiar_clave_notificaciones
# Los intentos del correo. Caben de sobra en los 60 s del criterio 3.
NOTIFY_MAX_ATTEMPTS=3
NOTIFY_TIMEOUT_SECONDS=30
NOTIFY_POLL_SECONDS=10

# Servidor de correo. Por defecto el buzon de desarrollo (mailpit), nunca un
# relay real: un despliegue mal configurado escribiria a supervisores de verdad.
# En planta se pone el relay corporativo, SMTP_SECURITY=starttls y el puerto 587.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURITY=ninguno
SMTP_USER=
# Nunca en el codigo ni en el repositorio (apartado 8). En planta, secreto de
# Docker o variable del entorno del despliegue.
SMTP_PASSWORD=
# Un buzon del sistema y no el de una persona: los avisos siguen saliendo
# cuando esa persona se va de la empresa.
SMTP_FROM=alertas@quinor.com.pe
SMTP_FROM_NAME=QUINOR - Control de despacho
SMTP_REPLY_TO=

# El enlace del criterio 2. El servicio de notificaciones no sabe donde esta
# publicado el dashboard, asi que se lo dicen.
DASHBOARD_BASE_URL=http://localhost:8501

# --- Puertos publicados ------------------------------------------------------
API_PORT=8000
DASHBOARD_PORT=8501
YOLO_PORT=8002
VLM_PORT=8003
NOTIFY_PORT=8004
# Interfaz web del buzon de desarrollo: ahi se leen los correos de HU-10.
MAILPIT_UI_PORT=8025

# --- Reservado para HU-17, Sprint 2 ------------------------------------------
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0
