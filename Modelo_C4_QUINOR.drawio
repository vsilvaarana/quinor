<mxfile host="app.diagrams.net" type="device"><diagram id="pg0" name="C4-1 Contexto"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1240" pageHeight="820" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="Nivel 1 - Diagrama de Contexto" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#0F3D5E;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="12" width="1200" height="34" as="geometry"/></mxCell><mxCell id="n3" value="Sistema de deteccion de sustraccion de quinua en el despacho (QUINOR S.A.C. - Alternativa 1)" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#6B7280;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="46" width="1200" height="22" as="geometry"/></mxCell><mxCell id="n4" value='&lt;b&gt;Operador de despacho&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9px"&gt;[Persona]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;Ejecuta la carga y la pesada. El sistema captura sus operaciones.&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#052E56;fontColor=#FFFFFF;fontSize=12;verticalAlign=top;spacing=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="120" y="90" width="230" height="110" as="geometry"/></mxCell><mxCell id="n5" value='&lt;b&gt;Supervisor de despacho&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9px"&gt;[Persona]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;Revisa los eventos, reproduce el clip y los clasifica.&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#052E56;fontColor=#FFFFFF;fontSize=12;verticalAlign=top;spacing=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="500" y="90" width="230" height="110" as="geometry"/></mxCell><mxCell id="n6" value='&lt;b&gt;Administrador del sistema&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9px"&gt;[Persona]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;Configura tolerancias, usuarios, roles y canales de alerta.&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#052E56;fontColor=#FFFFFF;fontSize=12;verticalAlign=top;spacing=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="880" y="90" width="230" height="110" as="geometry"/></mxCell><mxCell id="n7" value='&lt;b&gt;Sistema de deteccion de sustraccion en despacho&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9px"&gt;[Sistema]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;Compara el peso real con la orden, analiza el video de la carga con IA (YOLO y vision-lenguaje), detecta discrepancias y alerta al supervisor antes de que el contenedor salga de planta.&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#FFFFFF;fontSize=12;verticalAlign=top;spacing=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="430" y="360" width="380" height="180" as="geometry"/></mxCell><mxCell id="n8" value='&lt;b&gt;Bascula de despacho&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9px"&gt;[Sistema externo]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;Reporta el peso real al cerrar la carga.&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#6B6B6B;fontColor=#FFFFFF;fontSize=12;verticalAlign=top;spacing=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="70" y="300" width="250" height="95" as="geometry"/></mxCell><mxCell id="n9" value='&lt;b&gt;ERP / WMS&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9px"&gt;[Sistema externo]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;Provee la orden: peso y sacos esperados.&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#6B6B6B;fontColor=#FFFFFF;fontSize=12;verticalAlign=top;spacing=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="70" y="430" width="250" height="95" as="geometry"/></mxCell><mxCell id="n10" value='&lt;b&gt;Camaras IP de la rampa&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9px"&gt;[Sistema externo]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;Transmiten el video continuo de la zona de carga.&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#6B6B6B;fontColor=#FFFFFF;fontSize=12;verticalAlign=top;spacing=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="70" y="560" width="250" height="95" as="geometry"/></mxCell><mxCell id="n11" value='&lt;b&gt;Proveedor de vision-lenguaje&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9px"&gt;[Sistema externo]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;Describe lo ocurrido en el clip (Anthropic u OpenAI).&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#6B6B6B;fontColor=#FFFFFF;fontSize=12;verticalAlign=top;spacing=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="930" y="350" width="250" height="100" as="geometry"/></mxCell><mxCell id="n12" value='&lt;b&gt;Servidor de correo (SMTP)&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9px"&gt;[Sistema externo]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;Entrega las alertas por correo.&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#6B6B6B;fontColor=#FFFFFF;fontSize=12;verticalAlign=top;spacing=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="930" y="500" width="250" height="95" as="geometry"/></mxCell><mxCell id="e13" value="cierra la carga y pesa&#10;(captura automatica)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#5B6B7A;strokeWidth=1.5;fontSize=9;fontColor=#33434F;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n4" target="n7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e14" value="revisa y clasifica&#10;eventos [HTTPS]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#5B6B7A;strokeWidth=1.5;fontSize=9;fontColor=#33434F;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n5" target="n7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e15" value="configura tolerancias,&#10;usuarios y roles [HTTPS]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#5B6B7A;strokeWidth=1.5;fontSize=9;fontColor=#33434F;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n6" target="n7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e16" value="peso real [Modbus]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#5B6B7A;strokeWidth=1.5;fontSize=9;fontColor=#33434F;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n8" target="n7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e17" value="peso y sacos&#10;esperados [REST]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#5B6B7A;strokeWidth=1.5;fontSize=9;fontColor=#33434F;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n9" target="n7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e18" value="video de la rampa [RTSP]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#5B6B7A;strokeWidth=1.5;fontSize=9;fontColor=#33434F;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n10" target="n7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e19" value="describe el evento [HTTPS]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#5B6B7A;strokeWidth=1.5;fontSize=9;fontColor=#33434F;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n7" target="n11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e20" value="envia la alerta [SMTP]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#5B6B7A;strokeWidth=1.5;fontSize=9;fontColor=#33434F;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n7" target="n12"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="pg1" name="C4-2 Contenedores"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1480" pageHeight="980" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="Nivel 2 - Diagrama de Contenedores" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#0F3D5E;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="12" width="1440" height="34" as="geometry"/></mxCell><mxCell id="n3" value="Los cinco servicios de la solucion, el dashboard y el almacenamiento compartido" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#6B7280;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="46" width="1440" height="22" as="geometry"/></mxCell><mxCell id="n4" value='&lt;b&gt;Operador&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9px"&gt;[Persona]&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#052E56;fontColor=#FFFFFF;fontSize=12;verticalAlign=top;spacing=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="70" y="250" width="150" height="80" as="geometry"/></mxCell><mxCell id="n5" value='&lt;b&gt;Supervisor&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9px"&gt;[Persona]&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#052E56;fontColor=#FFFFFF;fontSize=12;verticalAlign=top;spacing=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="70" y="110" width="150" height="80" as="geometry"/></mxCell><mxCell id="n6" value='&lt;b&gt;Administrador&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9px"&gt;[Persona]&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#052E56;fontColor=#FFFFFF;fontSize=12;verticalAlign=top;spacing=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="250" y="110" width="150" height="80" as="geometry"/></mxCell><mxCell id="n7" value="Sistema de deteccion de sustraccion en despacho" style="rounded=1;html=1;dashed=1;dashPattern=8 8;fillColor=none;strokeColor=#2E6295;fontColor=#2E6295;verticalAlign=top;fontSize=13;fontStyle=2;align=left;spacingLeft=10;spacingTop=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="440" y="100" width="900" height="780" as="geometry"/></mxCell><mxCell id="n8" value='&lt;b&gt;Dashboard&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9px"&gt;[Contenedor: Streamlit :8501]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;Bandeja y detalle de eventos, tolerancias, usuarios.&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#FFFFFF;fontSize=12;verticalAlign=top;spacing=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="480" y="150" width="230" height="110" as="geometry"/></mxCell><mxCell id="n9" value='&lt;b&gt;Orquestador (api)&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9px"&gt;[Contenedor: FastAPI :8000]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;Pesadas, ordenes, eventos, tolerancias, usuarios y tokens, bandeja.&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#FFFFFF;fontSize=12;verticalAlign=top;spacing=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="480" y="310" width="230" height="130" as="geometry"/></mxCell><mxCell id="n10" value='&lt;b&gt;Grabador&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9px"&gt;[Contenedor: proceso Python]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;Buffer de video 72 h, recorte del clip; orquesta el analisis y la alerta.&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#FFFFFF;fontSize=12;verticalAlign=top;spacing=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="780" y="310" width="230" height="130" as="geometry"/></mxCell><mxCell id="n11" value='&lt;b&gt;Servicio YOLO&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9px"&gt;[Contenedor: FastAPI :8002]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;Conteo de sacos y seguimiento de personas (YOLO11n + ByteTrack).&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#FFFFFF;fontSize=12;verticalAlign=top;spacing=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1080" y="230" width="230" height="120" as="geometry"/></mxCell><mxCell id="n12" value='&lt;b&gt;Servicio VLM&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9px"&gt;[Contenedor: FastAPI :8003]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;Descripcion del evento y severidad (vision-lenguaje).&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#FFFFFF;fontSize=12;verticalAlign=top;spacing=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1080" y="400" width="230" height="120" as="geometry"/></mxCell><mxCell id="n13" value='&lt;b&gt;Notificaciones&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9px"&gt;[Contenedor: FastAPI :8004]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;Arma y envia el correo segun la severidad.&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#FFFFFF;fontSize=12;verticalAlign=top;spacing=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1080" y="570" width="230" height="120" as="geometry"/></mxCell><mxCell id="n14" value='&lt;b&gt;Base de datos&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9px"&gt;[MariaDB 11.4]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;13 tablas, 2 vistas, 3 triggers.&lt;/font&gt;' style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#FFFFFF;fontSize=12;verticalAlign=top;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="480" y="570" width="230" height="130" as="geometry"/></mxCell><mxCell id="n15" value='&lt;b&gt;Almacen de objetos&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9px"&gt;[MinIO (S3)]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;Clips y fotogramas clave (12 meses).&lt;/font&gt;' style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#FFFFFF;fontSize=12;verticalAlign=top;spacing=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="780" y="570" width="230" height="130" as="geometry"/></mxCell><mxCell id="n16" value='&lt;b&gt;Bascula&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9px"&gt;[Sistema externo]&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#6B6B6B;fontColor=#FFFFFF;fontSize=12;verticalAlign=top;spacing=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="480" y="760" width="150" height="80" as="geometry"/></mxCell><mxCell id="n17" value='&lt;b&gt;ERP / WMS&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9px"&gt;[Sistema externo]&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#6B6B6B;fontColor=#FFFFFF;fontSize=12;verticalAlign=top;spacing=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="670" y="760" width="150" height="80" as="geometry"/></mxCell><mxCell id="n18" value='&lt;b&gt;Camaras IP&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9px"&gt;[Sistema externo]&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#6B6B6B;fontColor=#FFFFFF;fontSize=12;verticalAlign=top;spacing=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="860" y="760" width="