das (HU-01)&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9px"&gt;[Componente]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;Registra la pesada al cerrar la carga.&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#2E6295;fontColor=#08294A;fontSize=11;verticalAlign=top;spacing=7;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="70" y="230" width="210" height="100" as="geometry"/></mxCell><mxCell id="n7" value='&lt;b&gt;Cliente de bascula&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9px"&gt;[Componente: pymodbus]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;Lee el peso por Modbus; reintenta a los 5 s.&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#2E6295;fontColor=#08294A;fontSize=11;verticalAlign=top;spacing=7;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="70" y="350" width="210" height="100" as="geometry"/></mxCell><mxCell id="n8" value='&lt;b&gt;Ordenes (HU-02)&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9px"&gt;[Componente]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;Obtiene de la orden el peso y los sacos esperados.&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#2E6295;fontColor=#08294A;fontSize=11;verticalAlign=top;spacing=7;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="320" y="230" width="210" height="100" as="geometry"/></mxCell><mxCell id="n9" value='&lt;b&gt;Cliente del ERP&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9px"&gt;[Componente: httpx]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;Consulta la orden al ERP y la cachea.&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#2E6295;fontColor=#08294A;fontSize=11;verticalAlign=top;spacing=7;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="320" y="350" width="210" height="100" as="geometry"/></mxCell><mxCell id="n10" value='&lt;b&gt;Cargas&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9px"&gt;[Componente]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;Marca el inicio y cierre de la ventana de carga.&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#2E6295;fontColor=#08294A;fontSize=11;verticalAlign=top;spacing=7;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="570" y="230" width="210" height="100" as="geometry"/></mxCell><mxCell id="n11" value='&lt;b&gt;Eventos (HU-03)&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9px"&gt;[Componente]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;Crea el evento si supera la tolerancia; RN-02.&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#2E6295;fontColor=#08294A;fontSize=11;verticalAlign=top;spacing=7;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="570" y="350" width="210" height="100" as="geometry"/></mxCell><mxCell id="n12" value='&lt;b&gt;Tolerancias (HU-04)&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9px"&gt;[Componente]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;Tolerancia por producto; aplica la mas restrictiva (RN-01).&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#2E6295;fontColor=#08294A;fontSize=11;verticalAlign=top;spacing=7;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="820" y="230" width="210" height="100" as="geometry"/></mxCell><mxCell id="n13" value='&lt;b&gt;Usuarios (HU-14)&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9px"&gt;[Componente]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;Alta, baja y roles de usuario.&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#2E6295;fontColor=#08294A;fontSize=11;verticalAlign=top;spacing=7;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="70" y="480" width="210" height="100" as="geometry"/></mxCell><mxCell id="n14" value='&lt;b&gt;Seguridad (HU-14)&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9px"&gt;[Componente: passlib]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;Hash bcrypt, token opaco y autenticacion.&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#2E6295;fontColor=#08294A;fontSize=11;verticalAlign=top;spacing=7;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="320" y="480" width="210" height="100" as="geometry"/></mxCell><mxCell id="n15" value='&lt;b&gt;Bandeja (HU-11)&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9px"&gt;[Componente]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;Lista de eventos con filtros para el dashboard.&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#2E6295;fontColor=#08294A;fontSize=11;verticalAlign=top;spacing=7;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="570" y="480" width="210" height="100" as="geometry"/></mxCell><mxCell id="n16" value='&lt;b&gt;Detalle (HU-12)&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9px"&gt;[Componente]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;Reune el detalle de un evento (en construccion).&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#2E6295;fontColor=#08294A;fontSize=11;verticalAlign=top;spacing=7;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="820" y="480" width="210" height="100" as="geometry"/></mxCell><mxCell id="n17" value='&lt;b&gt;Auditoria&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9px"&gt;[Componente]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;Registra cada cambio con usuario y fecha.&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#2E6295;fontColor=#08294A;fontSize=11;verticalAlign=top;spacing=7;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="820" y="350" width="210" height="100" as="geometry"/></mxCell><mxCell id="n18" value='&lt;b&gt;