94A;fontSize=11;verticalAlign=top;spacing=7;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="370" y="120" width="250" height="90" as="geometry"/></mxCell><mxCell id="n6" value='&lt;b&gt;Interpretacion (vlm)&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9px"&gt;[Componente]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;Orquesta la descripcion y la severidad del evento.&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#2E6295;fontColor=#08294A;fontSize=11;verticalAlign=top;spacing=7;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="370" y="240" width="250" height="100" as="geometry"/></mxCell><mxCell id="n7" value='&lt;b&gt;Invocacion (RN-03)&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9px"&gt;[Componente]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;Solo invoca al modelo si YOLO confirma la anomalia.&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#2E6295;fontColor=#08294A;fontSize=11;verticalAlign=top;spacing=7;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="70" y="370" width="230" height="110" as="geometry"/></mxCell><mxCell id="n8" value='&lt;b&gt;Prompt&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9px"&gt;[Componente]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;Arma el prompt con el contexto de planta y la evidencia.&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#2E6295;fontColor=#08294A;fontSize=11;verticalAlign=top;spacing=7;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="370" y="370" width="230" height="110" as="geometry"/></mxCell><mxCell id="n9" value='&lt;b&gt;Severidad (RN-04)&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9px"&gt;[Componente]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;Calcula Alta, Media o Baja con una regla; guarda severidad_ia aparte.&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#